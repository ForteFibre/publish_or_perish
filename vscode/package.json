{
  "name": "publish-or-perish",
  "displayName": "Publish or Perish",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "fortefibre",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "publishOrPerish.open",
        "title": "%command.open%",
        "category": "Publish or Perish"
      },
      {
        "command": "publishOrPerish.pip",
        "title": "%command.pip%",
        "category": "Publish or Perish"
      },
      {
        "command": "publishOrPerish.guide",
        "title": "%command.guide%",
        "category": "Publish or Perish"
      }
    ],
    "keybindings": [
      {
        "command": "publishOrPerish.pip",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      },
      {
        "command": "publishOrPerish.guide",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "publishOrPerish.url": {
          "type": "string",
          "default": "http://localhost:8765",
          "description": "%config.url%"
        },
        "publishOrPerish.rosbridge": {
          "type": "string",
          "default": "ws://localhost:9090",
          "description": "%config.rosbridge%"
        }
      }
    }
  },
  "l10n": "./l10n"
}
