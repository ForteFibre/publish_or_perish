<?xml version="1.0"?>
<!--
  match.launch.xml
  大会モード (関西春ロボコン 2027 のフィールド). MuJoCo のシミュレーター, rosbridge, 画面の HTTP サーバーを起動する.
  起動したらブラウザで http://localhost:8765/match.html を開く.
  ロボットは画面のキー (W A S D で移動, Q E で回転) か, /robot/cmd_vel (geometry_msgs/msg/Twist) で動く.
    web_port : 画面の HTTP のポート
-->
<launch>
  <arg name="web_port" default="8765"/>

  <node pkg="publish_or_perish" exec="match_sim.py" name="match_sim" output="screen"/>

  <include file="$(find-pkg-share rosbridge_server)/launch/rosbridge_websocket_launch.xml"/>

  <executable cmd="python3 $(find-pkg-share publish_or_perish)/scripts/web_server.py $(var web_port) $(find-pkg-share publish_or_perish)/web"
    output="log"/>
</launch>
